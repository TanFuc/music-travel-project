# Application
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/music_travel"

# Redis (Local Development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=7d

# Cors
CORS_ORIGINS=http://localhost:3000

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 (Object Storage)
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_REGION=auto

# Redis Configuration (Production - Upstash REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Payment Gateways
# MoMo
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# VNPay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=

# PayOS Payment Gateway
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key

# Bank QR Configuration
BANK_QR_TEST_MODE=true
QR_ERROR_CORRECTION_LEVEL=M
QR_IMAGE_WIDTH=300
QR_IMAGE_MARGIN=2
QR_CACHE_TTL=3600

# Admin Bank Account (for QR payments)
ADMIN_BANK_CODE=VPB
ADMIN_BANK_NAME=VPBank
ADMIN_ACCOUNT_NUMBER=10393335845
ADMIN_ACCOUNT_NAME=Le Duc Tuan

# Google Maps API (Optional)
GOOGLE_MAPS_API_KEY=
