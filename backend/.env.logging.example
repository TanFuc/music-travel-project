# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Environment-based logging settings for the comprehensive logging system
#
# Copy these to your .env.local (development) or .env (production) file
# =============================================================================

# -----------------------------------------------------------------------------
# Log Level
# -----------------------------------------------------------------------------
# Controls the minimum severity level for logs to be displayed
# Options: 'debug' | 'log' | 'warn' | 'error' | 'verbose'
#
# Recommended:
#   - Development: debug (shows all logs)
#   - Production: warn (only warnings and errors)
#
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
# Enable/disable specific logging features
# Options: true | false

# Enable method-level logging (@LogMethod decorator)
# Shows entry/exit and execution time for service methods
ENABLE_METHOD_LOGGING=true

# Enable request body logging
# Logs incoming request bodies (sanitized for sensitive data)
ENABLE_REQUEST_BODY_LOGGING=true

# Enable response body logging
# Logs outgoing response bodies (can be verbose)
# Note: Error responses are always logged regardless of this setting
ENABLE_RESPONSE_BODY_LOGGING=false

# Enable database query logging
# Logs all Prisma queries with duration and slow query warnings
ENABLE_DB_QUERY_LOGGING=true

# Enable sensitive data sanitization
# Automatically redacts passwords, tokens, etc. from logs
# IMPORTANT: Keep this enabled in production for security
LOG_SANITIZE_SENSITIVE=true

# -----------------------------------------------------------------------------
# Performance Settings
# -----------------------------------------------------------------------------

# Maximum body size to log (in characters)
# Bodies larger than this are truncated
# Default: 10000 characters
LOG_MAX_BODY_SIZE=10000

# Slow query threshold (in milliseconds)
# Queries slower than this threshold are logged as warnings
# Default: 100ms
LOG_SLOW_QUERY_THRESHOLD_MS=100

# -----------------------------------------------------------------------------
# Custom Sensitive Patterns (Advanced)
# -----------------------------------------------------------------------------
# Comma-separated list of additional field names to redact from logs
# Default patterns already include: password, token, apiKey, secret, etc.
#
# Example: LOG_CUSTOM_SENSITIVE_PATTERNS=customSecret,internalToken
LOG_CUSTOM_SENSITIVE_PATTERNS=

# =============================================================================
# RECOMMENDED CONFIGURATIONS
# =============================================================================

# Development (.env.local)
# -------------------------
# LOG_LEVEL=debug
# ENABLE_METHOD_LOGGING=true
# ENABLE_REQUEST_BODY_LOGGING=true
# ENABLE_RESPONSE_BODY_LOGGING=true
# ENABLE_DB_QUERY_LOGGING=true
# LOG_SANITIZE_SENSITIVE=true

# Production (.env)
# -----------------
# LOG_LEVEL=warn
# ENABLE_METHOD_LOGGING=false
# ENABLE_REQUEST_BODY_LOGGING=false
# ENABLE_RESPONSE_BODY_LOGGING=false
# ENABLE_DB_QUERY_LOGGING=false
# LOG_SANITIZE_SENSITIVE=true

# Staging/Testing
# ----------------
# LOG_LEVEL=log
# ENABLE_METHOD_LOGGING=true
# ENABLE_REQUEST_BODY_LOGGING=true
# ENABLE_RESPONSE_BODY_LOGGING=false
# ENABLE_DB_QUERY_LOGGING=true
# LOG_SANITIZE_SENSITIVE=true
